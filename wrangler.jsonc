{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dyno-plots",
  "compatibility_date": "2026-05-15",
  // Assets-only Worker (same pattern as the vnaviewer project): no `main`,
  // so `wrangler deploy` publishes the static export in ./out. Deployed via
  // Cloudflare Workers Builds, which injects account credentials — no
  // CLOUDFLARE_API_TOKEN needed.
  "assets": {
    "directory": "./out"
  }
}
